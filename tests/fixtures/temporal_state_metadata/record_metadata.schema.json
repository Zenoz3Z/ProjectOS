{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen record-level project-state metadata and closed selector input contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata_version",
    "review_status",
    "records",
    "reviewed_by",
    "review_date",
    "review_basis"
  ],
  "properties": {
    "metadata_version": {
      "const": "phase_3a_metadata_v1"
    },
    "review_status": {
      "const": "researcher_confirmed"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "reviewed_by": {
      "const": "Fuzhe Zhang"
    },
    "review_date": {
      "const": "2026-10-26"
    },
    "review_basis": {
      "const": "Researcher review of record-level functions and limitations, with confirmation conditional on the completed candidate-pool, query-order and static method audit."
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "project_id",
        "record_state",
        "record_date",
        "sequence_position",
        "state_basis",
        "state_scope",
        "source_category"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^[A-Z]{2}-R[0-9]{2}$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "record_state": {
          "enum": [
            "historical_record",
            "current_snapshot",
            "final_snapshot",
            "closure_record",
            "undated_record",
            "unknown"
          ]
        },
        "record_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "sequence_position": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "state_basis": {
          "enum": [
            "explicit_heading",
            "explicit_source_statement",
            "explicit_date",
            "supplied_manifest",
            "unknown"
          ]
        },
        "state_scope": {
          "type": "string",
          "minLength": 20,
          "maxLength": 600
        },
        "source_category": {
          "enum": [
            "current_state",
            "decisions",
            "process",
            "feedback"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "record_state": {
                "const": "undated_record"
              }
            }
          },
          "then": {
            "properties": {
              "record_date": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state_basis": {
                "const": "explicit_date"
              }
            }
          },
          "then": {
            "properties": {
              "record_date": {
                "type": "string",
                "format": "date"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "record_state": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "state_basis": {
                "const": "unknown"
              }
            }
          }
        }
      ]
    },
    "selector_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_id",
        "ordered_eligible_candidates",
        "eligible_record_states"
      ],
      "properties": {
        "section_id": {
          "enum": [
            "current_intention",
            "changes_and_reasons",
            "current_vs_superseded",
            "relevant_feedback",
            "unresolved_tensions",
            "possible_next_action"
          ]
        },
        "ordered_eligible_candidates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "chunk_id",
                "record_id",
                "score"
              ],
              "properties": {
                "chunk_id": {
                  "type": "string",
                  "minLength": 1
                },
                "record_id": {
                  "type": "string",
                  "pattern": "^[A-Z]{2}-R[0-9]{2}$"
                },
                "score": {
                  "type": "number"
                }
              }
            }
          }
        },
        "eligible_record_states": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Z]{2}-R[0-9]{2}$"
          },
          "additionalProperties": {
            "enum": [
              "historical_record",
              "current_snapshot",
              "final_snapshot",
              "closure_record",
              "undated_record",
              "unknown"
            ]
          }
        }
      },
      "description": "Closed input contract only; no selector implementation. Original query order is retained. Metadata values are state enum strings, never full records."
    }
  }
}
